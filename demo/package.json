{
  "name": "rolekv-demo",
  "private": true,
  "type": "module",
  "description": "Static RoleKV dashboard. No dependencies; package.json only marks js/ as ES modules for Node tests.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:py": "python -m unittest discover -s tests -p \"test_*.py\"",
    "data": "python collect_logs.py",
    "data:check": "python collect_logs.py --check",
    "mock": "python mock/make_mock.py",
    "serve": "python -m http.server 8000",
    "dev": "python -m http.server 8000"
  }
}
